  "endpoints": [
    {
      "name": "GetOredersWithSum",
      "method": "GET",
      "pathTemplate": "/get_orders_all",
      "sqlQuery": "\nSELECT\n  ISNULL(u.salesman_name, N'Bellenilmedik') AS [Satyjy],\n  ISNULL(w.wh_name, N'Bellenilmedik') AS [Sklad],\n  COUNT(DISTINCT o.fich_id) AS [Jemi sargyt],\n  COUNT(DISTINCT o.arap_id) AS [Jemi müşderi],\n  CAST(ISNULL(SUM(DISTINCT o.fich_nettotal), 0) AS DECIMAL(18, 2)) AS [Jemi baha],\n  COUNT(l.fich_line_id) AS [Jemi setir sany],\n  CAST(ISNULL(SUM(l.fich_line_amount), 0) AS DECIMAL(18, 2)) AS [Jemi haryt sany],\n  CAST(ISNULL(SUM(l.fich_line_amount * ISNULL(d.unit_det_conv2, 1) * CAST(m.mat_weight AS FLOAT)), 0) AS DECIMAL(18, 2)) AS [Jemi agram]\nFROM tbl_mg_order_fich o\nLEFT JOIN tbl_mg_order_fich_line l ON o.fich_id = l.fich_id\nLEFT JOIN tbl_mg_materials m ON l.material_id = m.material_id\nLEFT JOIN tbl_mg_unit_det d ON l.unit_det_id = d.unit_det_id\nLEFT JOIN tbl_mg_salesman u ON o.salesman_id = u.salesman_id\nLEFT JOIN tbl_mg_whouse w ON o.wh_id = w.wh_id\nWHERE o.fich_type_id = 12\n  AND o.fich_date BETWEEN @beginDate AND @endDate\n  AND (@salesman_id IS NULL OR u.salesman_id = @salesman_id)\n  AND (@wh_id IS NULL OR w.wh_id = @wh_id)\nGROUP BY\n  u.salesman_name,\n  w.wh_name\nORDER BY\n  [Jemi baha] DESC;",
      "paramsSchema": {
        "urlParams": [],
        "queryParams": [
          {
            "name": "beginDate",
            "sqlParam": "@beginDate",
            "type": "datetime",
            "required": true
          },
          {
            "name": "endDate",
            "sqlParam": "@endDate",
            "type": "datetime",
            "required": true
          },
          {
            "name": "salesman_id",
            "sqlParam": "@salesman_id",
            "type": "int",
            "required": true
          },
          {
            "name": "wh_id",
            "sqlParam": "@wh_id",
            "type": "int",
            "required": true
          }
        ],
        "bodyParams": []
      },
      "cacheTtlSec": 0,
      "authRequired": false,
      "dbKey": "primary",
      "connectionId": "64d35cab-f687-4f5e-a8b3-4a86d05d61df",
